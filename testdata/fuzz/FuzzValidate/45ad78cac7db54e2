string("\nstruct Meta { n: u32 }\n@group(0) @binding(0) var<storage, read> logits: array<f32>;\n@group(0) @binding(1) var<storage, read_write> tokens: array<u32>;\n@group(0) @binding(2) var<storage, read_write> outv: array<u32>;\n@group(0) @binding(3) var<storage, read> state: array<u32>;\n@group(0) @binding(4) var<storage, read> prm: Meta;\nvar<workgroup> bv: array<f32, 64>;\nvar<workgroup> bi: array<u32, 64>;\n\n@compute @workgroup_size(64)\nfn main(@builtin(local_invocation_index) li: u32) {\n  var best = -3.0e38;\n  var bidx = 0u;\n  var i = li;\n  loop {\n    if (i >= prm.n) { break; }\n    let v = logits[i];\n    if (v > best) { best = v; bidx = i; }\n    i = i + 64u;\n  }\n  bv[li] = best;\n  bi[li] = bidx;\n  workgroupBarrier();\n  var s = 64u / 2u;\n  loop {\n    if (s == 0u) { break; }\n    if (li < s) {\n      let ov = bv[li + s];\n      let oi = bi[li + s];\n      if (ov > bv[li] || (ov == bv[li] && oi < bi[li])) { bv[li] = ov; bi[li] = oi; }\n    }\n    workgroupBarrier();\n    s = s >> 1u;\n  }\n  if (li == 0u) {\n    tokens[state[1] + 1u] = bi[0];\n    outv[0] = bi[0];\n  }\n}\n")
