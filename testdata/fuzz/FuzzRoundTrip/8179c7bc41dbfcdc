string("\nvar<workgroup> red: array<f32, 64>;\n\nfn rsum(li: u32, v: f32) -> f32 {\n  red[li] = v;\n  workgroupBarrier();\n  var s = 64u / 2u;\n  loop {\n    if (s == 0u) { break; }\n    if (li < s) { red[li] = red[li] + red[li + s]; }\n    workgroupBarrier();\n    s = s >> 1u;\n  }\n  let r = red[0];\n  workgroupBarrier();\n  return r;\n}\n\nfn rmax(li: u32, v: f32) -> f32 {\n  red[li] = v;\n  workgroupBarrier();\n  var s = 64u / 2u;\n  loop {\n    if (s == 0u) { break; }\n    if (li < s) { red[li] = max(red[li], red[li + s]); }\n    workgroupBarrier();\n    s = s >> 1u;\n  }\n  let r = red[0];\n  workgroupBarrier();\n  return r;\n}\n\nstruct Meta { n: u32, eps: f32 }\n@group(0) @binding(0) var<storage, read> x: array<f32>;\n@group(0) @binding(1) var<storage, read> w: array<f32>;\n@group(0) @binding(2) var<storage, read_write> y: array<f32>;\n@group(0) @binding(3) var<storage, read> prm: Meta;\n\n@compute @workgroup_size(64)\nfn main(@builtin(local_invocation_index) li: u32) {\n  var ss = 0.0;\n  var i = li;\n  loop {\n    if (i >= prm.n) { break; }\n    ss = ss + x[i] * x[i];\n    i = i + 64u;\n  }\n  let tot = rsum(li, ss);\n  let s = 1.0 / sqrt(tot / f32(prm.n) + prm.eps);\n  i = li;\n  loop {\n    if (i >= prm.n) { break; }\n    y[i] = x[i] * s * w[i];\n    i = i + 64u;\n  }\n}\n")
